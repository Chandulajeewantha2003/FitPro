<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetStart="@+id/start"
        motion:constraintSetEnd="@+id/end"
        motion:duration="900"
        motion:autoTransition="animateToEnd">
        <KeyFrameSet>
            <KeyPosition
                motion:motionTarget="@id/imageView7"
                motion:framePosition="30"
                motion:keyPositionType="deltaRelative"
                motion:percentY="-0.1" />
            <KeyAttribute
                motion:motionTarget="@id/textView18"
                motion:framePosition="40"
                android:alpha="0.6" />
            <KeyAttribute
                motion:motionTarget="@id/textView19"
                motion:framePosition="60"
                android:alpha="0.8" />
            <KeyAttribute
                motion:motionTarget="@id/button5"
                motion:framePosition="85"
                android:scaleX="1.05"
                android:scaleY="1.05" />
            <KeyAttribute
                motion:motionTarget="@id/button5"
                motion:framePosition="100"
                android:scaleX="1.0"
                android:scaleY="1.0" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/textView18"
            android:alpha="0.0" />
        <Constraint
            android:id="@+id/textView19"
            android:alpha="0.0" />
        <Constraint
            android:id="@+id/imageView7"
            motion:layout_constraintWidth_percent="0.85"
            motion:layout_constraintHeight_percent="0.45"
            android:translationY="60dp" />
        <Constraint
            android:id="@+id/textView20"
            android:alpha="0.0" />
        <Constraint
            android:id="@+id/button5"
            android:alpha="0.0" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/textView18"
            android:alpha="1.0" />
        <Constraint
            android:id="@+id/textView19"
            android:alpha="1.0" />
        <Constraint
            android:id="@+id/imageView7"
            android:translationY="0dp" />
        <Constraint
            android:id="@+id/textView20"
            android:alpha="1.0" />
        <Constraint
            android:id="@+id/button5"
            android:alpha="1.0" />
    </ConstraintSet>
</MotionScene>


