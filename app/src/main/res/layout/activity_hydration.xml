<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".HydrationActivity">

    <!-- Header text -->
    <TextView
        android:id="@+id/tvNextHydration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready to hydrate in:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Next water amount -->
    <TextView
        android:id="@+id/tvNextAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="350 ml"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Custom Add Section -->
    <LinearLayout
        android:id="@+id/customAddLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="HH:MM"
            android:inputType="time" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Amount (ml)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnAddHydration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Up Next:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- RecyclerView for schedule -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHydrationSchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- Chart Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Water Progress"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Bar Chart -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/waterChart"
        android:layout_width="match_parent"
        android:layout_height="250dp"/>

    <!-- Total Water Consumed -->
    <TextView
        android:id="@+id/tvTotalWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 0 ml"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"/>
</LinearLayout>
